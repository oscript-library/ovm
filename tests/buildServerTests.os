/////////////////////////////////////////////////////
// Тесты установки сборок с сервера сборок (build.oscript.io)
/////////////////////////////////////////////////////

#Использовать "../src/core"

Перем Версии;
Перем Провайдер;

// BSLLS:DuplicateStringLiteral-off

#Область РазборСпецификацииСборки

&ПараметризованныйТест
&ИсточникЗначение("branch:develop", Истина)
&ИсточникЗначение("branch:feature/my-branch", Истина)
&ИсточникЗначение("BRANCH:develop", Истина)
&ИсточникЗначение("pr:1731", Истина)
&ИсточникЗначение("PR:1731", Истина)
&ИсточникЗначение("branch:develop#777", Истина)
&ИсточникЗначение("1.9.2", Ложь)
&ИсточникЗначение("dev", Ложь)
&ИсточникЗначение("", Ложь)
Процедура ОпределяетЧтоВерсияЯвляетсяСборкойСервераСборок(Знач Версия, Знач Ожидание) Экспорт

	Ожидаем.Что(Версии.ЭтоСборкаСервераСборок(Версия), Версия).Равно(Ожидание);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("branch:develop", "develop", "")
&ИсточникЗначение("branch:feature/my-branch", "feature/my-branch", "")
&ИсточникЗначение("BRANCH: develop ", "develop", "")
&ИсточникЗначение("pr:1731", "PR-1731", "")
&ИсточникЗначение("pr:PR-1731", "PR-1731", "")
&ИсточникЗначение("branch:develop#777", "develop", "777")
&ИсточникЗначение("pr:1731#3", "PR-1731", "3")
Процедура РазбираетСпецификациюСборкиНаИмяИНомер(Знач Версия, Знач ИмяСборки, Знач НомерСборки) Экспорт

	ПараметрыСборки = Версии.ПараметрыСборки(Версия);

	Ожидаем.Что(ПараметрыСборки.ИмяСборки, Версия).Равно(ИмяСборки);
	Ожидаем.Что(ПараметрыСборки.НомерСборки, Версия).Равно(НомерСборки);

КонецПроцедуры

&Тест
Процедура СчитаетРешеткуЧастьюИмениВеткиЕслиЗаНейНеНомер() Экспорт

	ПараметрыСборки = Версии.ПараметрыСборки("branch:feature/issue#42-fix");

	Ожидаем.Что(ПараметрыСборки.ИмяСборки).Равно("feature/issue#42-fix");
	Ожидаем.Что(ПараметрыСборки.НомерСборки).Равно("");

КонецПроцедуры

&Тест
Процедура ВыбрасываетИсключениеПриРазбореОбычнойВерсииКакСборки() Экспорт

	ПараметрыДействия = Новый Массив;
	ПараметрыДействия.Добавить("1.9.2");

	Ожидаем.Что(Версии).Метод("ПараметрыСборки", ПараметрыДействия)
		.ВыбрасываетИсключение("Версия <1.9.2> не является сборкой сервера сборок");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("branch:develop", "develop")
&ИсточникЗначение("branch:feature/my-branch", "feature-my-branch")
&ИсточникЗначение("pr:1731", "PR-1731")
&ИсточникЗначение("branch:develop#777", "develop-777")
&ИсточникЗначение("pr:1731#3", "PR-1731-3")
&ИсточникЗначение("1.9.2", "1.9.2")
&ИсточникЗначение("dev", "dev")
Процедура ВозвращаетАлиасУстановкиПоУмолчанию(Знач Версия, Знач Ожидание) Экспорт

	Ожидаем.Что(Версии.АлиасПоУмолчанию(Версия), Версия).Равно(Ожидание);

КонецПроцедуры

#КонецОбласти

#Область АдресаСборок

&ПараметризованныйТест
&ИсточникЗначение("develop", "", "job/1Script/job/develop/lastSuccessfulBuild")
&ИсточникЗначение("PR-1731", "", "job/1Script/job/PR-1731/lastSuccessfulBuild")
&ИсточникЗначение("feature/my-branch", "", "job/1Script/job/feature%252Fmy-branch/lastSuccessfulBuild")
&ИсточникЗначение("develop", "777", "job/1Script/job/develop/777")
&ИсточникЗначение("PR-1731", "3", "job/1Script/job/PR-1731/3")
Процедура ФормируетАдресСборки(Знач ИмяСборки, Знач НомерСборки, Знач Ожидание) Экспорт

	Ожидаем.Что(Провайдер.АдресСборки("1Script", ИмяСборки, НомерСборки), ИмяСборки).Равно(Ожидание);

КонецПроцедуры

#КонецОбласти

#Область ОпределениеВидаДистрибутива

&ПараметризованныйТест
&ИсточникЗначение("OneScript-2.2.0-dev+777-fdd-x86.zip", "fdd", "x86")
&ИсточникЗначение("OneScript-2.2.0-dev+777-fdd-x64.zip", "fdd", "x64")
&ИсточникЗначение("OneScript-2.2.0-dev+777-win-x86.zip", "scd-win", "x86")
&ИсточникЗначение("OneScript-2.2.0-dev+777-win-x64.zip", "scd-win", "x64")
&ИсточникЗначение("OneScript-2.2.0-dev+777-linux-x64.zip", "scd-lin", "x64")
&ИсточникЗначение("OneScript-2.2.0-dev+777-osx-x64.zip", "osx-x64", "x64")
&ИсточникЗначение("OneScript-2.2.0-dev+777-osx-arm64.zip", "osx-arm64", "x64")
&ИсточникЗначение("OneScript-2.1.0-linux-x64.zip", "scd-lin", "x64")
Процедура ОпределяетВидДистрибутиваПоИмениФайла(Знач ИмяФайла, Знач Вид, Знач Архитектура) Экспорт

	ОписаниеДистрибутива = Провайдер.ОписаниеДистрибутиваПоИмениФайла(ИмяФайла);

	Ожидаем.Что(ОписаниеДистрибутива, ИмяФайла).Существует();
	Ожидаем.Что(ОписаниеДистрибутива.Вид, ИмяФайла).Равно(Вид);
	Ожидаем.Что(ОписаниеДистрибутива.Архитектура, ИмяФайла).Равно(Архитектура);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("oscript-debug-1.1.0.vsix")
&ИсточникЗначение("syntax-helper.json")
&ИсточникЗначение("OneScript.2.2.0-dev.nupkg")
&ИсточникЗначение("tests.xml")
Процедура НеОпределяетВидДистрибутиваДляПостороннихАртефактов(Знач ИмяФайла) Экспорт

	Ожидаем.Что(Провайдер.ОписаниеДистрибутиваПоИмениФайла(ИмяФайла), ИмяФайла).ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область РазборСпискаАртефактов

&Тест
Процедура ОтбираетДистрибутивыИзСпискаАртефактовСборки() Экспорт

	ПереченьФайлов = Провайдер.ДистрибутивыИзОписанияАртефактов(
		ОтветСоСпискомАртефактов(),
		"job/1Script/job/develop/lastSuccessfulBuild/artifact"
	);

	Ожидаем.Что(ПереченьФайлов.Количество()).Равно(7);

	КритерийПоиска = Новый Структура("Вид, Архитектура", "scd-lin", "x64");
	НайденныеСтроки = ПереченьФайлов.НайтиСтроки(КритерийПоиска);

	Ожидаем.Что(НайденныеСтроки.Количество()).Равно(1);
	Ожидаем.Что(НайденныеСтроки[0].ИмяФайла).Равно("OneScript-2.2.0-dev+777-linux-x64.zip");
	Ожидаем.Что(НайденныеСтроки[0].Ссылка).Равно(
		"job/1Script/job/develop/lastSuccessfulBuild/artifact/built/OneScript-2.2.0-dev+777-linux-x64.zip"
	);

КонецПроцедуры

&Тест
Процедура ВозвращаетПустойПереченьФайловДляСборкиБезАртефактов() Экспорт

	ПереченьФайлов = Провайдер.ДистрибутивыИзОписанияАртефактов("{""artifacts"": []}", "artifact");

	Ожидаем.Что(ПереченьФайлов.Количество()).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область РазборСпискаСборок

&Тест
Процедура ОтбираетДоступныеСборкиИзСпискаЗаданий() Экспорт

	ДоступныеСборки = Провайдер.СборкиИзОписанияЗаданий(ОтветСоСпискомЗаданий());

	// Задания без успешных сборок в список не попадают
	Ожидаем.Что(ДоступныеСборки.Количество()).Равно(3);

	Ожидаем.Что(ДоступныеСборки[0].Алиас).Равно("pr:1555");
	Ожидаем.Что(ДоступныеСборки[0].Путь).Равно("https://build.oscript.io/job/1Script/job/PR-1555/");

	Ожидаем.Что(ДоступныеСборки[1].Алиас).Равно("branch:develop");

	// Косая черта в имени ветки приходит от Jenkins в закодированном виде
	Ожидаем.Что(ДоступныеСборки[2].Алиас).Равно("branch:copilot/fix-debug-attach-issue");

КонецПроцедуры

#КонецОбласти

Функция ОтветСоСпискомАртефактов()

	Возврат "{
	|  ""_class"": ""org.jenkinsci.plugins.workflow.job.WorkflowRun"",
	|  ""artifacts"": [
	|    {""fileName"": ""syntax-helper.json"", ""relativePath"": ""built/docs/json/syntax-helper.json""},
	|    {""fileName"": ""OneScript.2.2.0-dev.nupkg"", ""relativePath"": ""built/nuget/OneScript.2.2.0-dev.nupkg""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-fdd-x64.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-fdd-x64.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-fdd-x86.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-fdd-x86.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-linux-x64.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-linux-x64.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-osx-arm64.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-osx-arm64.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-osx-x64.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-osx-x64.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-win-x64.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-win-x64.zip""},
	|    {""fileName"": ""OneScript-2.2.0-dev+777-win-x86.zip"", ""relativePath"": ""built/OneScript-2.2.0-dev+777-win-x86.zip""},
	|    {""fileName"": ""oscript-debug-1.1.0.vsix"", ""relativePath"": ""built/vscode/oscript-debug-1.1.0.vsix""}
	|  ]
	|}";

КонецФункции

Функция ОтветСоСпискомЗаданий()

	Возврат "{
	|  ""_class"": ""org.jenkinsci.plugins.workflow.multibranch.WorkflowMultiBranchProject"",
	|  ""jobs"": [
	|    {
	|      ""name"": ""PR-1555"",
	|      ""url"": ""https://build.oscript.io/job/1Script/job/PR-1555/"",
	|      ""lastSuccessfulBuild"": {""number"": 7}
	|    },
	|    {
	|      ""name"": ""PR-1566"",
	|      ""url"": ""https://build.oscript.io/job/1Script/job/PR-1566/"",
	|      ""lastSuccessfulBuild"": null
	|    },
	|    {
	|      ""name"": ""develop"",
	|      ""url"": ""https://build.oscript.io/job/1Script/job/develop/"",
	|      ""lastSuccessfulBuild"": {""number"": 777}
	|    },
	|    {
	|      ""name"": ""copilot%2Ffix-debug-attach-issue"",
	|      ""url"": ""https://build.oscript.io/job/1Script/job/copilot%252Ffix-debug-attach-issue/"",
	|      ""lastSuccessfulBuild"": {""number"": 1}
	|    }
	|  ]
	|}";

КонецФункции

///////////////////////////
Версии = Новый ВерсииOneScript;
Провайдер = Новый ПровайдерДистрибутивовСборки;
