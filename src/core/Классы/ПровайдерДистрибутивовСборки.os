&ЛогOVM
Перем Лог;

&Пластилин
Перем ФабрикаИнтернетСоединения;

&Пластилин
Перем АдресСервераСборок;

&Пластилин
Перем ЗаданиеСервераСборок;

&Желудь
Процедура ПриСозданииОбъекта()
КонецПроцедуры

// Возвращает таблицу файлов дистрибутивов сборки ветки или пул-реквеста
//
// Параметры:
//  ИмяСборки   - Строка - Имя ветки или пул-реквеста на сервере сборок (develop, PR-1731, feature/my-branch)
//  НомерСборки - Строка - Номер сборки. Если не указан, используется последняя успешная сборка
//
// Возвращаемое значение:
//   ТаблицаЗначений - Вид,ИмяФайла,Архитектура,Ссылка
//      Вид: fdd,scd-win,scd-lin,osx-x64,osx-arm64
//      ИмяФайла: имя файла
//      Архитектура: x64,x86
//      Ссылка: ссылка на файл относительно адреса сервера сборок
// См. также:
//     https://build.oscript.io/job/1Script/ - список веток и пул-реквестов
//
Функция ПолучитьДоступныеВидыДистрибутивовСборки(Знач ИмяСборки, Знач НомерСборки = "") Экспорт

	АдресСборки = АдресСборки(ЗаданиеСервераСборок, ИмяСборки, НомерСборки);
	Ресурс = АдресСборки + "/api/json?tree=artifacts%5BfileName,relativePath%5D";

	Лог.Отладка("Сервер: %1. Ресурс: %2", АдресСервераСборок, Ресурс);

	Соединение = ФабрикаИнтернетСоединения.Создать(АдресСервераСборок);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Ресурс));

	HTTP_OK = 200;
	Если Ответ.КодСостояния <> HTTP_OK Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось найти сборку <%1> на сервере сборок %2: Статус: %3",
			ПредставлениеСборки(ИмяСборки, НомерСборки),
			АдресСервераСборок,
			Ответ.КодСостояния
		);
	КонецЕсли;

	ПереченьФайлов = ДистрибутивыИзОписанияАртефактов(
		Ответ.ПолучитьТелоКакСтроку(),
		АдресСборки + "/artifact"
	);

	Если ПереченьФайлов.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(
			"Сборка <%1> на сервере сборок %2 не содержит дистрибутивов OneScript",
			ПредставлениеСборки(ИмяСборки, НомерСборки),
			АдресСервераСборок
		);
	КонецЕсли;

	Возврат ПереченьФайлов;

КонецФункции

// Получить информацию о сборках веток и пул-реквестов, доступных к установке
//
//  Возвращаемое значение:
//   ТаблицаЗначений - Информация о доступных сборках:
//		* Алиас - Строка - Спецификация сборки для команды install (branch:develop, pr:1731)
//		* Путь  - Строка - Полный адрес задания сборки на сервере сборок
//
Функция ПолучитьСписокДоступныхКУстановкеСборок() Экспорт

	Ресурс = СтрШаблон(
		"job/%1/api/json?tree=jobs%%5Bname,url,lastSuccessfulBuild%%5Bnumber%%5D%%5D",
		ЗаданиеСервераСборок
	);

	Лог.Отладка("Сервер: %1. Ресурс: %2", АдресСервераСборок, Ресурс);

	Соединение = ФабрикаИнтернетСоединения.Создать(АдресСервераСборок);
	Ответ = Соединение.Получить(Новый HTTPЗапрос(Ресурс));

	HTTP_OK = 200;
	Если Ответ.КодСостояния <> HTTP_OK Тогда
		ВызватьИсключение СтрШаблон(
			"Не удалось получить список сборок с сервера сборок %1. Код ошибки: %2",
			АдресСервераСборок,
			Ответ.КодСостояния
		);
	КонецЕсли;

	Возврат СборкиИзОписанияЗаданий(Ответ.ПолучитьТелоКакСтроку());

КонецФункции

// Отбирает сборки, доступные к установке, из ответа сервера сборок со списком заданий
//
// Параметры:
//  ТелоОтвета - Строка - Тело ответа api/json многоветочного задания со списком заданий веток
//
// Возвращаемое значение:
//   ТаблицаЗначений - Алиас,Путь
//
Функция СборкиИзОписанияЗаданий(Знач ТелоОтвета) Экспорт

	ДоступныеСборки = Новый ТаблицаЗначений;
	ДоступныеСборки.Колонки.Добавить("Алиас");
	ДоступныеСборки.Колонки.Добавить("Путь");

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);

	ОписаниеЗадания = ПрочитатьJSON(ЧтениеJSON, Истина);
	Задания = ОписаниеЗадания.Получить("jobs");

	Если Задания = Неопределено Тогда
		Возврат ДоступныеСборки;
	КонецЕсли;

	Для Каждого Задание Из Задания Цикл

		// Задание без успешных сборок установить нельзя
		Если Не ЗначениеЗаполнено(Задание.Получить("lastSuccessfulBuild")) Тогда
			Продолжить;
		КонецЕсли;

		// Jenkins отдает "/" в именах веток закодированным как %2F
		ИмяСборки = РаскодироватьСтроку(Задание.Получить("name"), СпособКодированияСтроки.КодировкаURL);

		ДоступнаяСборка = ДоступныеСборки.Добавить();
		ДоступнаяСборка.Алиас = СпецификацияСборки(ИмяСборки);
		ДоступнаяСборка.Путь = Задание.Получить("url");

	КонецЦикла;

	Возврат ДоступныеСборки;

КонецФункции

// Относительный адрес сборки ветки или пул-реквеста на сервере сборок
//
// Параметры:
//  ИмяЗадания  - Строка - Имя многоветочного задания сборки (например, 1Script)
//  ИмяСборки   - Строка - Имя ветки или пул-реквеста (например, develop или PR-1731)
//  НомерСборки - Строка - Номер сборки. Если не указан, используется последняя успешная сборка
//
// Возвращаемое значение:
//   Строка - Относительный адрес сборки
//
Функция АдресСборки(Знач ИмяЗадания, Знач ИмяСборки, Знач НомерСборки = "") Экспорт

	// Jenkins хранит "/" в именах веток закодированным как %2F,
	// поэтому в адресе задания он должен быть закодирован дважды.
	ЗакодированноеИмяСборки = СтрЗаменить(
		КодироватьСтроку(ИмяСборки, СпособКодированияСтроки.КодировкаURL),
		"%2F",
		"%252F"
	);

	Возврат СтрШаблон(
		"job/%1/job/%2/%3",
		ИмяЗадания,
		ЗакодированноеИмяСборки,
		?(ЗначениеЗаполнено(НомерСборки), НомерСборки, "lastSuccessfulBuild")
	);

КонецФункции

Функция СпецификацияСборки(Знач ИмяСборки)

	РегулярноеВыражение = Новый РегулярноеВыражение("^PR-(\d+)$");
	РегулярноеВыражение.ИгнорироватьРегистр = Ложь;
	РегулярноеВыражение.МногоСтрочный = Ложь;

	Совпадения = РегулярноеВыражение.НайтиСовпадения(ИмяСборки);
	Если Совпадения.Количество() = 1 Тогда
		Возврат "pr:" + Совпадения[0].Группы[1].Значение;
	КонецЕсли;

	Возврат "branch:" + ИмяСборки;

КонецФункции

Функция ПредставлениеСборки(Знач ИмяСборки, Знач НомерСборки)

	Если Не ЗначениеЗаполнено(НомерСборки) Тогда
		Возврат ИмяСборки;
	КонецЕсли;

	Возврат ИмяСборки + "#" + НомерСборки;

КонецФункции

// Отбирает дистрибутивы OneScript из ответа сервера сборок со списком артефактов
//
// Параметры:
//  ТелоОтвета      - Строка - Тело ответа api/json сборки со списком артефактов
//  АдресАртефактов - Строка - Адрес каталога артефактов сборки, к которому дописывается путь файла
//
// Возвращаемое значение:
//   ТаблицаЗначений - Вид,ИмяФайла,Архитектура,Ссылка
//
Функция ДистрибутивыИзОписанияАртефактов(Знач ТелоОтвета, Знач АдресАртефактов) Экспорт

	ТаблицаРезультата = Новый ТаблицаЗначений();
	ТаблицаРезультата.Колонки.Добавить("Вид");
	ТаблицаРезультата.Колонки.Добавить("ИмяФайла");
	ТаблицаРезультата.Колонки.Добавить("Архитектура");
	ТаблицаРезультата.Колонки.Добавить("Ссылка");

	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);

	ОписаниеСборки = ПрочитатьJSON(ЧтениеJSON, Истина);
	Артефакты = ОписаниеСборки.Получить("artifacts");

	Если Артефакты = Неопределено Тогда
		Возврат ТаблицаРезультата;
	КонецЕсли;

	Для Каждого Артефакт Из Артефакты Цикл

		ИмяФайла = Артефакт.Получить("fileName");
		ОписаниеДистрибутива = ОписаниеДистрибутиваПоИмениФайла(ИмяФайла);

		Если ОписаниеДистрибутива = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		СтрокаТаблицы = ТаблицаРезультата.Добавить();
		СтрокаТаблицы.Вид = ОписаниеДистрибутива.Вид;
		СтрокаТаблицы.Архитектура = ОписаниеДистрибутива.Архитектура;
		СтрокаТаблицы.ИмяФайла = ИмяФайла;
		СтрокаТаблицы.Ссылка = АдресАртефактов + "/" + Артефакт.Получить("relativePath");

	КонецЦикла;

	Возврат ТаблицаРезультата;

КонецФункции

// Определяет вид и архитектуру дистрибутива OneScript по имени файла артефакта
//
// Параметры:
//  ИмяФайла - Строка - Имя файла артефакта сборки
//
// Возвращаемое значение:
//   Структура, Неопределено - Неопределено, если файл не является дистрибутивом OneScript:
//		* Вид          - Строка - Вид дистрибутива (fdd, scd-win, scd-lin, osx-x64, osx-arm64)
//		* Архитектура  - Строка - Разрядность дистрибутива (x86, x64)
//
Функция ОписаниеДистрибутиваПоИмениФайла(Знач ИмяФайла) Экспорт

	РегулярноеВыражение = Новый РегулярноеВыражение("^OneScript-.+-(fdd|win|linux|osx)-(x86|x64|arm64)\.zip$");
	РегулярноеВыражение.ИгнорироватьРегистр = Ложь;
	РегулярноеВыражение.МногоСтрочный = Ложь;

	Совпадения = РегулярноеВыражение.НайтиСовпадения(ИмяФайла);
	Если Совпадения.Количество() <> 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Платформа = Совпадения[0].Группы[1].Значение;
	Разрядность = Совпадения[0].Группы[2].Значение;

	Результат = Новый Структура("Вид, Архитектура");

	Если Платформа = "osx" Тогда
		Результат.Вид = "osx-" + Разрядность;
		// Дистрибутивы для macOS на сайте OneScript помечены архитектурой x64 независимо от вида
		Результат.Архитектура = "x64";
	Иначе
		Результат.Вид = ВидДистрибутиваПоПлатформе(Платформа);
		Результат.Архитектура = Разрядность;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ВидДистрибутиваПоПлатформе(Знач Платформа)

	Если Платформа = "win" Тогда
		Возврат "scd-win";
	ИначеЕсли Платформа = "linux" Тогда
		Возврат "scd-lin";
	Иначе
		Возврат Платформа;
	КонецЕсли;

КонецФункции
